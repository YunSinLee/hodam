# Public values; get these from the linked Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Never put these in next.config.js env or a NEXT_PUBLIC_* variable.
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-5.4-2026-03-05
# Independent editor. Change only after running the live quality fixtures.
OPENAI_STORY_REVIEW_MODEL=gpt-5.4-2026-03-05
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Required to enable payment and automatic recovery of confirmed failed saves.
# Apply the reviewed accounting migration with the new payment server first.
SUPABASE_SERVICE_ROLE_KEY=
TOSS_PAYMENTS_SECRET_KEY=
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=

# Optional analytics
NEXT_PUBLIC_GA_ID=

# Optional OAuth, webhook, observability and operational checks.
NEXT_PUBLIC_AUTH_REDIRECT_URL=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
TOSS_PAYMENTS_WEBHOOK_SECRET=
TOSS_PAYMENTS_WEBHOOK_HMAC_SECRET=
HODAM_DAILY_AI_COST_LIMIT=120
HODAM_DAILY_TTS_CHAR_LIMIT=30000
SENTRY_DSN=
