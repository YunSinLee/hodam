# Public values; get these from the linked Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Never put these in next.config.js env or a NEXT_PUBLIC_* variable.
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Required to enable payment and automatic recovery of confirmed failed saves.
# Apply the reviewed accounting migration with the new payment server first.
SUPABASE_SERVICE_ROLE_KEY=
TOSS_PAYMENTS_SECRET_KEY=
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=

# Optional analytics
NEXT_PUBLIC_GA_ID=
